# Career OS configuration, by example. Copy the lines an environment
# needs into its own env file and fill in the values there.
#
#   local       export them in your shell, or keep your own .env and
#               source it; this repo reads no dotenv file by itself.
#   on the VPS  /etc/careeros/prod.env and /etc/careeros/stg.env, which
#               the systemd units load with EnvironmentFile
#               (deploy/systemd/, deploy/RUNBOOK.md). Those files are
#               root-owned, mode 0640, group = the service's group.
#
# EVERY VARIABLE HERE IS READ BY REAL CODE, and the file that reads it is
# named beside it. A variable the app does not read would be worse than
# missing: it would look like a setting and change nothing.
#
# NOTHING HERE IS A SECRET AND NOTHING HERE MAY BECOME ONE. Every value
# below is either a real default or a placeholder. A real key, password
# or hash belongs only in the env file on the server, entered with
# `sudoedit`, and never in this repo (AGENTS.md, Secrets).
#
# Every variable is optional: left unset, each one falls back to the
# value a local run has always used, which is why a fresh clone starts
# with no configuration at all.

# --- where the records are -------------------------------------------------

# The vault directory (careeros/users.py, vault_root). `--vault PATH` on
# the command line still wins over this, for both the server and the
# accounts command.
#
# On the VPS the unit sets this itself, AFTER EnvironmentFile, so this
# line in an env file cannot move an environment's vault:
#   prod /srv/careeros/prod/vault     stg /srv/careeros/stg/vault
CAREEROS_VAULT=/root/career-os

# --- where the server listens ----------------------------------------------

# Nowhere: there is no variable for it. Locally,
# `careeros/server.py`'s main() takes --host (default 0.0.0.0) and --port
# (default 8788) as flags. On the VPS the systemd units run gunicorn,
# which is told where to listen on its own command line:
#   --bind 127.0.0.1:8001   (prod)
#   --bind 127.0.0.1:8002   (stg)
# Both environments bind the loopback only, so Caddy is the one thing
# reachable from outside.

# --- the front end ----------------------------------------------------------

# Serve the built React front end where it exists (careeros/server.py,
# create_app). The build output (frontend/dist) is committed and ships in
# every release checkout -- the CI job `frontend-dist` keeps it fresh --
# so this flag is all it takes to serve the React front end. On the VPS,
# set it in /etc/careeros/stg.env and /etc/careeros/prod.env and restart
# the service. The flag is only honoured when the build is really there,
# so setting it on a release without one changes nothing.
CAREEROS_REACT_UI=1
# Where that build is, if it is not <repo>/frontend/dist.
CAREEROS_REACT_DIST=/srv/careeros/prod/app/current/frontend/dist

# --- the session cookie -----------------------------------------------------

# Flag the session cookie `Secure`, so that a browser sends it back only
# over HTTPS (careeros/server.py, create_app). Off unless set to 1, and
# off is what a local run needs: a browser will not send a Secure cookie
# back over plain HTTP, so a local instance on http:// would sign in and
# immediately look signed out. The cookie is HttpOnly and SameSite=Lax
# either way. create_app reads this once, at startup, so an edit on the
# VPS takes effect when the service is restarted and not before.
#
# The post-deploy smoke test is not a reason to leave this off: it signs
# in over http://127.0.0.1 with curl, and curl treats the loopback as a
# trustworthy origin and does replay a Secure cookie over plain HTTP
# there (verified against curl 7.81 on 2026-10-26; the VPS's newer curl
# is assumed to behave the same until checked once by hand).
#
# On the VPS both environments are reached only through Caddy over HTTPS,
# which is where this line earns its place. Still, leave it out until it
# has been proven by hand on that box: turn it on in ONE env file,
# restart, run the smoke test, and confirm a real browser session over
# https:// still works. Staging keeps it off until staging's own smoke
# path is proven -- Caddy asks for basic auth in front of staging and
# tests/smoke.sh sends no basic-auth credentials, so a by-hand HTTPS
# smoke there 401s at Caddy today.
# deploy/RUNBOOK.md, "Known gaps", 3, is the one place that says this in
# full.
#CAREEROS_SESSION_COOKIE_SECURE=1

# --- the LLM ---------------------------------------------------------------

# The OpenAI-compatible endpoint, the model, and the key
# (careeros/llm_client.py). The key is the one real secret in this file:
# one key per environment, each with its own spend limit.
#
# An environment with none of these set is a working environment: an
# extraction there settles as `not_configured` (careeros/ingest.py), a
# visible failure with no invented fields. See deploy/RUNBOOK.md,
# "Known gaps".
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=the-model-name
LLM_API_KEY=paste-the-key-here

# Talk to Ollama's native /api/chat instead of the OpenAI-compatible
# path. Only for an LLM_BASE_URL that points at Ollama.
LLM_NATIVE=1

# Per-call request timeout and the whole-extraction deadline, in seconds
# (careeros/ingest.py).
LLM_TIMEOUT=120
LLM_TOTAL_DEADLINE=240

# --- the classification pipeline: LAN only ---------------------------------

# THE VPS DOES NOT RUN THIS PIPELINE. `scripts/run_classification.py`
# and the nightly run on the owner's LAN against a local model, so these
# belong in a LAN shell and in no env file on the server
# (careeros/classify/llm.py, Config.from_env).
CLASSIFY_LLM_BASE_URL=http://192.168.1.10:11434/v1
CLASSIFY_LLM_MODEL=the-local-model-name
CLASSIFY_LLM_API_KEY=ollama
CLASSIFY_LLM_NATIVE=1
CLASSIFY_LLM_TEMPERATURE=0

# Let the company backfill cascade fall back to the LLM for a sector or a
# size it cannot settle offline (careeros/enrich.py). Off unless set,
# because it is the one path that spends money per company.
BACKFILL_USE_LLM=1

# --- the smoke test ---------------------------------------------------------

# tests/smoke.sh and deploy/smoke.sh sign in and assert that real pages
# answer. The account is a dedicated tester created on the server, never
# the owner's, and its password is generated into a root-owned file
# rather than typed (deploy/RUNBOOK.md, "The tester account").
SMOKE_BASE_URL=https://app.career-os.ch
SMOKE_EMAIL=<the tester account you created>
SMOKE_PASSWORD=generated-on-the-server-never-here
# Seconds per request.
SMOKE_TIMEOUT=20
