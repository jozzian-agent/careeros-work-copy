# Career OS configuration, by example. Copy the lines an environment
# needs into its own env file and fill in the values there.
#
#   local       export them in your shell, or keep your own .env and
#               source it; this repo reads no dotenv file by itself.
#   on the VPS  /etc/careeros/prod.env and /etc/careeros/stg.env, which
#               the systemd units load with EnvironmentFile
#               (deploy/systemd/, deploy/README.md). Those files are
#               root-owned, mode 0640, group = the service's group.
#
# NOTHING HERE IS A SECRET AND NOTHING HERE MAY BECOME ONE. Every value
# below is either a real default or a placeholder. A real key, password
# or hash belongs only in the env file on the server, entered with
# `sudoedit`, and never in this repo (AGENTS.md, Secrets).
#
# Every variable is optional: left unset, each one falls back to the
# value a local run has always used, which is why a fresh clone starts
# with no configuration at all.

# --- where the records are -------------------------------------------------

# The vault directory. `--vault PATH` on the command line still wins over
# this, for both the server and the accounts command.
# prod: /srv/careeros/prod/vault   stg: /srv/careeros/stg/vault
CAREEROS_VAULT=/root/career-os

# --- where the server listens ----------------------------------------------

# `--host` / `--port` on the command line still win over these.
# On the VPS both environments bind the loopback only, so Caddy is the
# one thing reachable from outside: prod 127.0.0.1:8001, stg 127.0.0.1:8002.
CAREEROS_HOST=0.0.0.0
CAREEROS_PORT=8788

# Send the session cookie over HTTPS only. Set to 1 wherever the app is
# reached through Caddy (both VPS environments). Leave unset for a plain
# HTTP local or LAN run: a Secure cookie would never come back, which
# looks exactly like a broken login.
SESSION_COOKIE_SECURE=1

# --- the front end ----------------------------------------------------------

# Serve the built React front end where it exists. The build output
# (frontend/dist) is not in Git, so this does nothing until
# `npm --prefix frontend run build` has run in the release.
CAREEROS_REACT_UI=1
# Where that build is, if it is not <repo>/frontend/dist.
CAREEROS_REACT_DIST=/srv/careeros/prod/app/current/frontend/dist

# --- the LLM ---------------------------------------------------------------

# The OpenAI-compatible endpoint, the model, and the key. The key is the
# one real secret in this file: one key per environment, each with its
# own spend limit (deploy runbook Part 5).
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=the-model-name
LLM_API_KEY=paste-the-key-here

# Talk to Ollama's native /api/chat instead of the OpenAI-compatible
# path. Only for an LLM_BASE_URL that points at Ollama.
LLM_NATIVE=1

# Per-call request timeout and the whole-extraction deadline, in seconds.
LLM_TIMEOUT=120
LLM_TOTAL_DEADLINE=240

# Answer from canned replies and never open a socket. What the test suite
# and CI run on, which is how no test and no CI job needs a key. An
# environment with this on reads no posting, so an extraction there
# settles as a visible failure rather than inventing fields.
LLM_MOCK=1

# Make no LLM call at all: every caller gets one clean "LLM disabled"
# error instead. For an environment that has no key yet and should say so
# rather than fail at the transport a minute later. Wins over LLM_MOCK
# when both are set.
LLM_DISABLED=1

# The company classification pipeline (scripts/run_classification.py)
# reads its own host, because it runs against a local model on the LAN
# rather than against the hosted endpoint above. LLM_MOCK and
# LLM_DISABLED cover this layer too.
CLASSIFY_LLM_BASE_URL=http://192.168.1.10:11434/v1
CLASSIFY_LLM_MODEL=the-local-model-name
CLASSIFY_LLM_API_KEY=ollama
CLASSIFY_LLM_NATIVE=1
CLASSIFY_LLM_TEMPERATURE=0

# Let the company backfill cascade fall back to the LLM for a sector or a
# size it cannot settle offline. Off unless set, because it is the one
# path that spends money per company.
BACKFILL_USE_LLM=1

# --- the smoke test ---------------------------------------------------------

# tests/smoke.sh and deploy/smoke.sh sign in as a dedicated tester
# account and assert that real pages answer. The account is created on
# the server and its password is generated into a root-owned file, never
# typed (deploy/smoke.sh's header has the three commands).
SMOKE_BASE_URL=https://app.career-os.ch
SMOKE_EMAIL=smoke@career-os.ch
SMOKE_PASSWORD=generated-on-the-server-never-here
# Seconds per request.
SMOKE_TIMEOUT=20
