.venv/
__pycache__/
.pytest_cache/
*.py[cod]

.wheelhouse/
tmp-brief*.md
/tmp/
.hermes-handover.md

frontend/node_modules/
frontend/dist/

.hermes/

# M1: running the app or the accounts command against the sample vault
# leaves a session signing key and real user records there. Both are
# secrets, and neither belongs in the fictional sample data.
sample/vault/secret_key
sample/vault/users/

# CAREER-52 staging output (regenerable, 1.5MB+)
data/seeds/

# CAREER-53 staging output. The raw feed snapshots are the bulk of it --
# one gzipped XML body per tenant per language per run -- and a full
# crawl's worth is hundreds of megabytes. The tenants file, the run
# manifest and the exports are small but derived, and TRIAL_REPORT.md is
# the one part of it that is meant to be read, so it is tracked
# explicitly below.
data/personio/*
!data/personio/TRIAL_REPORT.md
tmp-plan-vision-to-mvp.md
tmp-vision-and-mvp.md
