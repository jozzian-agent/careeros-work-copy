# Career OS, production. Installed by deploy/setup-vps.sh to
# /etc/systemd/system/careeros-prod.service.
#
# HOW THE APP IS ACTUALLY STARTED
#   `python -m careeros.server`, which is what README.md documents and
#   what careeros/server.py's main() implements: argparse flags whose
#   defaults come from the environment, then Flask's own app.run(). It is
#   not a uvicorn app -- there is no ASGI entry point in this codebase
#   and no uvicorn or gunicorn in requirements.txt -- so this unit starts
#   what exists rather than what a WSGI deployment would prefer. See
#   deploy/README.md, "Known gaps", before putting real traffic on it.
#   `python -m` puts the working directory on sys.path, which is how the
#   release's own `careeros` package is the one that gets imported.
#
# WHY THE Environment= LINES COME AFTER EnvironmentFile=
#   systemd applies these in file order, so the later ones win. The env
#   file is the owner's (the LLM key, the model, the cookie flag); the
#   four below are facts about where this environment lives, fixed by the
#   directory layout and by the Caddyfile that proxies to this port. An
#   edit to the env file must not be able to move the port out from under
#   Caddy or point production at another vault, so the unit has the last
#   word on those.

[Unit]
Description=Career OS (production)
Documentation=file:///srv/careeros/prod/app/current/deploy/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=careeros-prod
Group=careeros-prod
WorkingDirectory=/srv/careeros/prod/app/current
EnvironmentFile=/etc/careeros/prod.env
Environment=CAREEROS_VAULT=/srv/careeros/prod/vault
Environment=CAREEROS_HOST=127.0.0.1
Environment=CAREEROS_PORT=8001
Environment=PYTHONUNBUFFERED=1
ExecStart=/srv/careeros/prod/app/current/.venv/bin/python -m careeros.server
Restart=on-failure
RestartSec=5s

# Hardening. The app reads its release tree and writes exactly one
# place: the vault, where every record, the id counters and the session
# signing key live (careeros/vault.py and careeros/users.py write
# through a temporary file in the same directory, so the vault is the
# only writable path either of them needs). Temporary files anywhere
# else go to the private /tmp below.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=no
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
ReadWritePaths=/srv/careeros/prod/vault

[Install]
WantedBy=multi-user.target
