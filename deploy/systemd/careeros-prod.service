# Career OS, production. Installed by deploy/setup-vps.sh to
# /etc/systemd/system/careeros-prod.service.
#
# INSTALLED, NOT ENABLED. setup-vps.sh places this file and reloads
# systemd; enabling and starting production is an owner step, because the
# first production start is the moment live data begins to exist
# (deploy/RUNBOOK.md, "Production, the first time").
#
# HOW THE APP IS ACTUALLY STARTED
#   gunicorn, the production WSGI server, from the release's own venv.
#   Flask's app.run() -- which is what careeros/server.py's main() uses --
#   is a development server, and deploy/RUNBOOK.md's fourth known gap said
#   adding gunicorn and changing this one line was the whole change to make
#   when traffic justified it. The first real run showed both environments
#   serving real clicks behind Caddy, so it is justified now.
#
#   `careeros.server:create_app()` names the module, then the factory, and
#   the parentheses are what make gunicorn call it rather than look for an
#   application object. create_app(vault=None) resolves the vault from
#   CAREEROS_VAULT, which this unit already sets with Environment= after
#   EnvironmentFile= below, so nothing else about how the app is built
#   changes. The app still reads NO variable for the host or the port: a
#   `CAREEROS_PORT=` line in the env file would be read by nothing, and
#   gunicorn's --bind here is the only place the port is said.
#
#   main() in careeros/server.py stays as it is. It is how the app is run
#   locally (`python -m careeros.server`), and the tests build the app
#   through create_app directly; neither path goes through this unit.
#
#   WorkingDirectory below puts the release on sys.path, which is how the
#   release's own `careeros` package is the one that gets imported.
#
# WHY THE Environment= LINES COME AFTER EnvironmentFile=
#   systemd applies these in file order, so the later ones win. The env
#   file is the owner's (the LLM key, the model); the two below are facts
#   about where this environment lives, fixed by the directory layout. An
#   edit to the env file must not be able to point production at another
#   vault, so the unit has the last word on that.
#
# THE MEMORY LIMITS
#   This box has 1.9 GB and runs staging beside production. MemoryHigh is
#   the point from which the kernel reclaims hard and the process is
#   slowed down; MemoryMax is the point at which it is killed and
#   Restart=on-failure brings it back. Both limits cover the whole service,
#   meaning gunicorn's master and ALL of its workers together, so the
#   --workers count below is spent out of this one budget.
#
# WHY TWO WORKERS AND NOT MORE
#   Each worker is a separate process holding its own copy of the app. The
#   single-process Flask server this replaces fit inside the same 768M, so
#   two sync workers fit beside staging on a 1.9 GB box; a larger number
#   would spend the budget on processes and end in the OOM-kill the limit
#   is there to make survivable. Two is also what buys the one thing the
#   old arrangement could not do: a worker that dies is respawned by
#   gunicorn's master while the other one keeps answering, instead of the
#   whole environment going down and waiting for Restart=on-failure.

[Unit]
Description=Career OS (production)
Documentation=file:///srv/careeros/prod/app/current/deploy/RUNBOOK.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=careeros-prod
Group=careeros-prod
WorkingDirectory=/srv/careeros/prod/app/current
EnvironmentFile=/etc/careeros/prod.env
Environment=CAREEROS_VAULT=/srv/careeros/prod/vault
Environment=PYTHONUNBUFFERED=1
ExecStart=/srv/careeros/prod/app/current/.venv/bin/gunicorn --bind 127.0.0.1:8001 --workers 2 careeros.server:create_app()
Restart=on-failure
RestartSec=5s
MemoryHigh=512M
MemoryMax=768M

# Hardening. The app reads its release tree and writes exactly one
# place: the vault, where every record, the id counters and the session
# signing key live (careeros/vault.py and careeros/users.py write
# through a temporary file in the same directory, so the vault is the
# only writable path either of them needs). Temporary files anywhere
# else go to the private /tmp below.
#
# gunicorn wants one more thing it does not get here: a control socket
# under this account's home directory, which setup-vps.sh set to
# /srv/careeros/<env> and ProtectSystem=strict leaves read-only, with
# ProtectHome=yes closing the runtime directory it would fall back to. So
# gunicorn logs one `Control server error:` line at every start and then
# serves normally, which was checked rather than assumed. The hardening is
# worth more than a control interface nothing here uses, so that line is
# expected: deploy/RUNBOOK.md's fourth known gap tells the owner so.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=no
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
ReadWritePaths=/srv/careeros/prod/vault

[Install]
WantedBy=multi-user.target
