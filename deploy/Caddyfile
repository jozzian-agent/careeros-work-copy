# Career OS reverse proxy. Caddy is the only thing on this box reachable
# from the internet: both app processes bind 127.0.0.1 only (see
# deploy/systemd/), so this file is the whole public surface.
#
# setup-vps.sh installs this to /etc/caddy/Caddyfile only when that file
# is still the stock default, so it can never overwrite a hash the owner
# pasted in or a hostname they changed.
#
# PASTE_HASH_HERE is a placeholder and must stay one in this repo. Make
# the real hash on the server with `caddy hash-password`, which prompts
# for the password and prints the hash, then `sudoedit /etc/caddy/Caddyfile`:
# nothing about that password ever reaches a command line, this repo, or
# a log. Then `caddy validate --config /etc/caddy/Caddyfile` and
# `systemctl reload caddy`. deploy/RUNBOOK.md, step 6, has this as a
# checklist with the expected output of each command.
#
# `me` is the basic-auth user name, not an account in the app: it is
# typed into the browser's own dialog in front of staging and means
# nothing to Career OS.
#
# Staging is behind basic auth because it is reachable by hostname and
# holds a synthetic vault; production is not, because the app's own login
# gate is in front of every route it serves.
#
# Caddy gets the TLS certificates itself, over HTTP-01 on port 80, for
# both names. That is why 80 stays open in ufw even though nothing is
# served on it.

app.career-os.ch {
    encode zstd gzip
    reverse_proxy 127.0.0.1:8001
}

# Public landing page (CAREER-99): static files only, plus the one live
# endpoint. /waitlist goes to the waiting-list collector (port 8003,
# collector/README.md); everything else is served from the rsync'd
# landing/ directory. try_files so /imprint and /privacy work without
# the .html. www redirects to the bare domain.
www.career-os.ch {
    redir https://career-os.ch{uri} permanent
}

career-os.ch {
    root * /srv/careeros/landing
    encode zstd gzip

    # The only live endpoint: POST /waitlist to the collector. A GET on
    # the same path stays a static miss (404/redirect to file_server
    # finds nothing), which is fine -- nothing links to it.
    @waitlist_post {
        method POST
        path /waitlist
    }
    handle @waitlist_post {
        reverse_proxy 127.0.0.1:8003 {
            # Overwrite (not append) any client-sent XFF with the real
            # peer address, so the collector's rate-limit identity
            # cannot be spoofed by rotating fake header values.
            header_up X-Forwarded-For {remote_host}
        }
    }

    handle {
        try_files {path} {path}.html
        file_server
    }
    header / Cache-Control "no-cache"
}

staging.career-os.ch {
    encode zstd gzip
    basic_auth {
        me PASTE_HASH_HERE
    }
    reverse_proxy 127.0.0.1:8002
}
